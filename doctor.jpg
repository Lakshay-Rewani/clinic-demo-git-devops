<svg width="400" height="400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="400" fill="#f0f4f8"/>
  
  <!-- Gradient Circle -->
  <circle cx="200" cy="150" r="80" fill="url(#grad1)"/>
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Body -->
  <ellipse cx="200" cy="320" rx="100" ry="80" fill="#667eea" opacity="0.8"/>
  
  <!-- Head placeholder circle -->
  <circle cx="200" cy="150" r="60" fill="#ffffff" opacity="0.9"/>
  
  <!-- Medical Cross -->
  <g transform="translate(200, 150)">
    <rect x="-8" y="-25" width="16" height="50" fill="#4facfe"/>
    <rect x="-25" y="-8" width="50" height="16" fill="#4facfe"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="370" font-family="Arial" font-size="18" font-weight="bold" fill="#2d3748" text-anchor="middle">Dr. Amit Sharma</text>
  <text x="200" y="390" font-family="Arial" font-size="14" fill="#718096" text-anchor="middle">Chief Medical Officer</text>
</svg>
